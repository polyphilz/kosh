# Kosh currently uses the same SILO77 updater publisher key as Dara. Keep its
# encrypted private key outside this repository.
TAURI_SIGNING_PRIVATE_KEY_PATH="/Users/your-name/Library/Application Support/SILO77/Dara Release/dara-updater.key"
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=replace-with-the-key-password
