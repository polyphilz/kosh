{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "category": "Productivity",
    "shortDescription": "Capture loose knowledge and find the exact passage that matters.",
    "longDescription": "Kosh is a local-first note taker for capturing tidbits, searching their exact and semantic content, and producing source-grounded research.",
    "copyright": "Copyright © 2026 Kosh contributors",
    "resources": {
      "resources/release/bin/llama-server": "bin/llama-server",
      "resources/release/llama-server.json": "release/llama-server.json",
      "resources/release/licenses/llama.cpp-LICENSE": "licenses/llama.cpp-LICENSE",
      "resources/embedding-indexes/jina-v1.json": "embedding-indexes/jina-v1.json",
      "resources/embedding-indexes/jina-v1-golden.json": "embedding-indexes/jina-v1-golden.json"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "entitlements": "Entitlements.plist"
    }
  }
}
