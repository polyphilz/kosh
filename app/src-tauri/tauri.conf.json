{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kosh",
  "version": "0.1.0",
  "identifier": "com.rohan.kosh",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzQ0IzNzM5RDUwNjY0QTEKUldTaFpBYlZPVGZMODNiTWFFUlg0MW9MRjNpS2RCRlpzUzRteWxjWFZHT09oYnBiWTIzMHZsbDMK",
      "endpoints": ["https://github.com/polyphilz/kosh/releases/latest/download/latest.json"]
    }
  },
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Kosh",
        "visible": false,
        "width": 1000,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "freezePrototype": true,
      "capabilities": ["default", "quick-add"],
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' blob: data: kosh-media:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "kosh-media:",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:1420",
        "img-src": "'self' blob: data: kosh-media:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "kosh-media:",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": false
  }
}
