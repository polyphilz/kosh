# Local-only credentials used by the opt-in Litestream/R2 protocol spike.
# Copy this file to app/.env and fill in the values. Never commit app/.env.
KOSH_LITESTREAM_R2_ACCOUNT_ID=
KOSH_LITESTREAM_R2_JURISDICTION=DEFAULT
KOSH_LITESTREAM_R2_BUCKET=
KOSH_LITESTREAM_R2_PREFIX=kosh/primary/protocol-spike
KOSH_LITESTREAM_R2_ACCESS_KEY_ID=
KOSH_LITESTREAM_R2_SECRET_ACCESS_KEY=
