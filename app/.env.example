# Local-only credentials for opt-in Litestream/R2 protocol and recovery canaries.
# Copy to app/.env, fill in the values, and chmod 600 app/.env. Never commit it.
KOSH_LITESTREAM_R2_ACCOUNT_ID=
KOSH_LITESTREAM_R2_JURISDICTION=DEFAULT
KOSH_LITESTREAM_R2_BUCKET=
# Only the low-level protocol spike uses this value. The complete recovery
# canary creates a unique kosh/v1/backup-sets/<id> prefix for every run.
KOSH_LITESTREAM_R2_PREFIX=kosh/primary/protocol-spike
KOSH_LITESTREAM_R2_ACCESS_KEY_ID=
KOSH_LITESTREAM_R2_SECRET_ACCESS_KEY=
